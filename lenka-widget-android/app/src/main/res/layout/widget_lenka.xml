<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7FAF9" android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LENKA" android:textColor="#176B61" android:textStyle="bold" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="18sp" android:textColor="#17211E"/>
    <TextView android:id="@+id/widget_schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textSize="15sp" android:textColor="#17211E"/>
    <TextView android:id="@+id/widget_homework" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:maxLines="4" android:textSize="14sp" android:textColor="#17211E"/>
    <TextView android:id="@+id/widget_meal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:maxLines="3" android:textSize="13sp" android:textColor="#52615C"/>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:textSize="10sp" android:textColor="#687570"/>
</LinearLayout>
