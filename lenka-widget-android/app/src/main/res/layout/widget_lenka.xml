<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F7FAF9" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LENKA" android:textColor="#176B61" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:gravity="end" android:textColor="#17211E" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="#17211E" android:textSize="14sp" />
    <LinearLayout android:id="@+id/widget_schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal">
            <TextView android:id="@+id/lesson_1" style="@style/WidgetLesson" />
            <TextView android:id="@+id/lesson_2" style="@style/WidgetLesson" />
            <TextView android:id="@+id/lesson_3" style="@style/WidgetLesson" />
            <TextView android:id="@+id/lesson_4" style="@style/WidgetLesson" />
            <TextView android:id="@+id/lesson_5" style="@style/WidgetLesson" />
            <TextView android:id="@+id/lesson_6" style="@style/WidgetLesson" />
        </LinearLayout>
        <TextView android:id="@+id/widget_clubs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="3" android:textColor="#52615C" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_changes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="10" android:textColor="#A4362A" android:textSize="11sp" />
    <TextView android:id="@+id/widget_tests" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="10" android:textColor="#3E4655" android:textSize="11sp" />
    <TextView android:id="@+id/widget_homework" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1" android:maxLines="14" android:textColor="#3E4655" android:textSize="11sp" />
    <TextView android:id="@+id/widget_meal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="3" android:textColor="#3E4655" android:textSize="12sp" />
    <TextView android:id="@+id/widget_clothing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="5" android:textColor="#173E38" android:textSize="12sp" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textColor="#176B61" android:textSize="10sp" />
</LinearLayout>
